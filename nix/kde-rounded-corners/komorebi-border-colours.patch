diff -ruN a/src/WindowColours.h b/src/WindowColours.h
--- a/src/WindowColours.h	1969-12-31 16:00:00
+++ b/src/WindowColours.h	2026-10-26 23:12:15
@@ -0,0 +1,98 @@
+/**
+ * @file WindowColours.h
+ * @brief Per-window colours for the outer outline, set from outside over D-Bus (komorebi).
+ *
+ * A tiling window manager knows better than "the active window" which windows are what: the
+ * focused one on each monitor, a stack, a monocled window, a floating window, a locked container.
+ * It says so, and this effect draws the outer outline of each window it has a colour for in that
+ * colour. Windows it has none for are drawn as the settings say.
+ *
+ * The object is on the session bus at /org/komorebi/BorderColours, interface
+ * org.komorebi.BorderColours1, reached through KWin's own name (org.kde.KWin).
+ */
+
+#pragma once
+
+#include <QColor>
+#include <QDBusConnection>
+#include <QHash>
+#include <QList>
+#include <QObject>
+#include <QStringList>
+#include <QUuid>
+#include <optional>
+
+#if QT_VERSION_MAJOR >= 6
+#include <effect/effecthandler.h>
+#include <effect/effectwindow.h>
+#else
+#include <kwineffects.h>
+#endif
+
+namespace ShapeCorners
+{
+    class WindowColours final : public QObject
+    {
+        Q_OBJECT
+        Q_CLASSINFO("D-Bus Interface", "org.komorebi.BorderColours1")
+
+    public:
+        static WindowColours &instance()
+        {
+            static WindowColours colours;
+            return colours;
+        }
+
+        void registerOnBus()
+        {
+            QDBusConnection::sessionBus().registerObject(QStringLiteral("/org/komorebi/BorderColours"), this,
+                                                         QDBusConnection::ExportAllSlots);
+        }
+
+        void unregisterFromBus()
+        {
+            QDBusConnection::sessionBus().unregisterObject(QStringLiteral("/org/komorebi/BorderColours"));
+            m_colours.clear();
+        }
+
+        /// The colour this window's outer outline is to be drawn in, if it was given one
+        [[nodiscard]]
+        std::optional<QColor> colourFor(const KWin::EffectWindow *window) const
+        {
+            if (m_colours.isEmpty()) {
+                return std::nullopt;
+            }
+            const auto found = m_colours.constFind(window->internalId());
+            if (found == m_colours.constEnd()) {
+                return std::nullopt;
+            }
+            return *found;
+        }
+
+    public Q_SLOTS:
+        /// Replace the colours of every window at once: window uuids (as KWin writes them, with or
+        /// without braces) and 0xRRGGBB values, in step. Windows not named go back to the settings.
+        void SetColours(const QStringList &windows, const QList<uint> &rgb)
+        {
+            QHash<QUuid, QColor> colours;
+            for (qsizetype i = 0; i < windows.size() && i < rgb.size(); ++i) {
+                const auto id = QUuid::fromString(windows[i]);
+                if (!id.isNull()) {
+                    colours.insert(id, QColor::fromRgb(rgb[i] & 0xFFFFFF));
+                }
+            }
+
+            if (colours == m_colours) {
+                return;
+            }
+            m_colours = colours;
+
+            for (auto *window: KWin::effects->stackingOrder()) {
+                window->addRepaintFull();
+            }
+        }
+
+    private:
+        QHash<QUuid, QColor> m_colours;
+    };
+} // namespace ShapeCorners
