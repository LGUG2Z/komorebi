+            unredirect(kwindow);
+            redirect(kwindow);
+            setShader(kwindow, m_shaderManager.GetShader().get());
+            kwindow->addRepaintFull();
+        };
+        for (auto *kwindow: KWin::effects->stackingOrder()) {
+            connect(kwindow, &KWin::EffectWindow::windowOpacityChanged, this, refreshOnOpacity);
+        }
+        connect(KWin::effects, &KWin::EffectsHandler::windowAdded, this,
+                [this, refreshOnOpacity](KWin::EffectWindow *kwindow) {
+                    connect(kwindow, &KWin::EffectWindow::windowOpacityChanged, this, refreshOnOpacity);
+                });
