diff -ruN a/package/contents/code/main.js b/package/contents/code/main.js
--- a/package/contents/code/main.js	2026-10-26 21:55:40
+++ b/package/contents/code/main.js	2026-10-26 21:55:40
@@ -17,6 +17,12 @@
         this.duration = animationTime(duration);
         this.excludedWindowClasses = effect.readConfig("ExcludedWindowClasses", "krunner,yakuake").split(",");
         this.crossFade = effect.readConfig("CrossFade", false);
+        // komorebi: any of Qt's easing curves by name ("OutExpo", "InOutSine", ...), which is how it
+        // says what its `animation.style` is; an unknown or missing name is the effect's own curve
+        this.curve = QEasingCurve[effect.readConfig("Curve", "OutExpo")];
+        if (this.curve === undefined) {
+            this.curve = QEasingCurve.OutExpo;
+        }
     }
 
     manage(window) {
@@ -128,7 +134,7 @@
         animate({
             window: window,
             duration: this.duration,
-            curve: QEasingCurve.OutExpo,
+            curve: this.curve,
             animations: animations,
         });
     }
diff -ruN a/package/contents/config/main.xml b/package/contents/config/main.xml
--- a/package/contents/config/main.xml	2026-10-26 22:29:29
+++ b/package/contents/config/main.xml	2026-10-26 22:29:29
@@ -14,5 +14,8 @@
         <entry name="CrossFade" type="Bool">
             <default>false</default>
         </entry>
+        <entry name="Curve" type="String">
+            <default>OutExpo</default>
+        </entry>
     </group>
 </kcfg>
