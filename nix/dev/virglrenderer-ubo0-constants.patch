+/*
+ * A guest can bind constant buffer 0 as a buffer resource (SET_UNIFORM_BUFFER) instead of as
+ * inline constants (SET_CONSTANT_BUFFER): Mesa's vl_compositor does for the colour matrix of an
+ * RGB to YUV conversion. A shader reads its constant buffer 0 as the default uniform block
+ * (fsconst0[]), which only the inline constants fill, and the UBOs are for the buffers from 1:
+ * the matrix stayed zero, and the conversion wrote zeros. Read the buffer into the uniforms. It
+ * is read at every draw, as the guest can write to the buffer without binding it again. Returns
+ * whether the constants came from the buffer.
+ */
+static bool vrend_draw_bind_const0_buffer(struct vrend_sub_context *sub_ctx,
+                                          int shader_type)
+{
+   const struct vrend_shader_selector *sel = sub_ctx->shaders[shader_type];
+   const struct pipe_constant_buffer *cb = &sub_ctx->cbs[shader_type][0];
+   const struct vrend_resource *res = (const struct vrend_resource *)cb->buffer;
+   unsigned num_consts, bytes;
+   uint32_t *data;
+
+   if (!sub_ctx->const0_from_buffer[shader_type] || !sel || !sel->sinfo.num_consts ||
+       sub_ctx->prog->const_location[shader_type] == -1 ||
+       !(sub_ctx->const_bufs_used_mask[shader_type] & 1) ||
+       !res || !has_bit(res->storage_bits, VREND_STORAGE_GL_BUFFER))
+      return false;
+
+   num_consts = sel->sinfo.num_consts;
+   bytes = num_consts * 4 * sizeof(uint32_t);
+   data = calloc(1, bytes);
+   if (!data)
+      return true;
+
+   glBindBuffer(GL_COPY_READ_BUFFER, res->gl_id);
+   glGetBufferSubData(GL_COPY_READ_BUFFER, cb->buffer_offset,
+                      MIN2(bytes, cb->buffer_size), data);
+   glBindBuffer(GL_COPY_READ_BUFFER, 0);
+
+   glUniform4uiv(sub_ctx->prog->const_location[shader_type], num_consts, data);
+   free(data);
+
+   return true;
+}
+
 static void vrend_draw_bind_const_shader(struct vrend_sub_context *sub_ctx,
                                          int shader_type, bool new_program)
 {
+   if (vrend_draw_bind_const0_buffer(sub_ctx, shader_type))
+      return;
+
    if (sub_ctx->consts[shader_type].consts &&
